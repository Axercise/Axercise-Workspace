{
  "name": "axercise-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "axercise": "./bin/axercise.mjs"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "axercise": "node bin/axercise.mjs",
    "typecheck": "tsc --noEmit",
    "check:hermes": "node scripts/check-hermes.mjs",
    "setup:learning": "node scripts/setup-learning.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "0.577.0",
    "next": "16.4.5",
    "node-notifier": "12.1.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
